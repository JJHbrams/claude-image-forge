# Copy to .env and fill in what you use. .env is gitignored and its values are
# never logged, printed, or put in a URL.
#
# Everything here is optional. With none of it set, the chain still runs on
# whatever local model and subscription CLIs it finds.

# --- local tier (ComfyUI) --------------------------------------------------
# Free and unlimited, but you install it yourself. See "로컬 티어 설치" in the
# README for what to download and where to put it.

# Where ComfyUI listens. Default http://127.0.0.1:8188
# COMFY_URL=http://127.0.0.1:8188

# Checkpoint filename as it appears in ComfyUI's models/checkpoints folder.
# Default flux1-schnell-fp8.safetensors. If yours is named differently, set it
# here — the chain reports which names it can actually see when this is wrong.
# COMFY_CKPT=flux1-schnell-fp8.safetensors

# Sampling steps. The default 4 is what Flux schnell is distilled for; raising
# it costs time without improving that model. Other checkpoints want 20-30.
# COMFY_STEPS=4

# How long to wait for one render, in ms. Default 600000 (10 min) — a cold
# start loads the whole model from disk and can take minutes.
# COMFY_TIMEOUT_MS=600000

# --- metered API tier (Gemini) ---------------------------------------------
# Needs a key from Google AI Studio, attached to a project with billing. A free
# key will not work: image generation is not merely exhausted on the free tier,
# it is unallocated (limit: 0).
GEMINI_API_KEY=

# gemini-2.5-flash-image (default, fast) | gemini-3-pro-image-preview (up to 4K)
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- subscription CLI tiers ------------------------------------------------
# No keys. These use CLIs you have already logged into.

# Absolute path to the real codex executable, if auto-detection misses it.
# On Windows this MUST be the vendored .exe, not the codex.cmd / codex.ps1
# shim on PATH — the chain spawns without a shell and those shims fail.
# CODEX_BIN=

# Absolute path to the agy executable, if auto-detection misses it.
# AGY_BIN=

# Which model drives agy's generate_image tool. generate_image is a tool, so
# the model calling it does not have to be Gemini — and when Gemini's quota is
# gone, an agy turn on a Gemini model hangs instead of erroring.
# AGY_MODEL=claude-sonnet-4-6

# How long to wait for one subscription-CLI render, in ms. Default 300000.
# IMAGE_FORGE_TIMEOUT_MS=300000
