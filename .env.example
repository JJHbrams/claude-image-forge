# Copy to .env and fill in. .env is gitignored and its values are never logged.

# T2 backend. Get one from Google AI Studio.
GEMINI_API_KEY=

# Optional: gemini-2.5-flash-image (default, fast) | gemini-3-pro-image-preview (up to 4K)
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Optional: absolute path to the real codex executable.
# Auto-detected otherwise. On Windows this MUST be the vendored .exe, not the
# codex.cmd / codex.ps1 shim on PATH — the script spawns without a shell.
# CODEX_BIN=

# Optional: T1 timeout in ms (default 300000).
# BANNER_FORGE_TIMEOUT_MS=
